# Copy to cluster.env (ignored by git). Everything here is optional.
# Large storage for checkpoints, clips, and outputs. Must be visible from every node.
# export EGOTAC_ROOT=/scratch/$USER/egotac
# Where MANO_LEFT.pkl and MANO_RIGHT.pkl live. Default: $EGOTAC_ROOT/mano
# export MANO_DIR=/scratch/$USER/mano
# VGGT-Omega weights, if the cluster already has them. Otherwise training downloads them, which needs
# HF_TOKEN from an account with access to https://huggingface.co/facebook/VGGT-Omega
# export VGGT_CHECKPOINT=/models/vggt_omega_1b_512.pt
# export HF_TOKEN=...
# Where each dataset already lives on the cluster. Read-only; nothing is downloaded. The expected
# folder layout is at the top of each egotac/data/convert_*.py. Default: $EGOTAC_ROOT/data/<name>
# export DATA_OAKINK2=/datasets/OakInk-v2
# export DATA_TACO=/datasets/TACO
# export DATA_HOI4D=/datasets/HOI4D
# export DATA_H2O=/datasets/H2O
# export DATA_H2O_OBJECTS=/datasets/H2O/object
# export DATA_HOT3D=/datasets/HOT3D-Clips
# export DATA_ARCTIC=/datasets/arctic_data/data
# Python 3.10.12 interpreter used to build the environment. Default: python3
# export EGOTAC_BASE_PYTHON=/usr/bin/python3
# Force a CUDA build of PyTorch: cu118, cu124, or cu126. Default: chosen from nvidia-smi.
# export TORCH_CUDA=cu124
