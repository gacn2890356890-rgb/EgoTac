# Anchored: a bare "data/" would also ignore the egotac/data/ source package.
/third_party/
/data/
/outputs/
__pycache__/
.pytest_cache/
*.pt
*.pth
*.npz

# The repository root ignores data/; this one is source code.
!/egotac/data/
!/egotac/data/**

# Local environment and per-cluster settings
/.venv/
/workspace/
/cluster.env

# The official code ships these small data files.
!/EgoFound3R_original/egohandmetric_prompt/data/
!/EgoFound3R_original/egohandmetric_prompt/data/**
!/EgoFound3R_world/egohandmetric_prompt/data/
!/EgoFound3R_world/egohandmetric_prompt/data/**
