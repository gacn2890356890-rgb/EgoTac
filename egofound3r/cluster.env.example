# Copy to cluster.env (ignored by git). Everything here is optional.
# Large storage for checkpoints, clips, and outputs. Must be visible from every node.
# export EGOTAC_ROOT=/scratch/$USER/egotac
# Where MANO_LEFT.pkl and MANO_RIGHT.pkl live. Default: $EGOTAC_ROOT/mano
# export MANO_DIR=/scratch/$USER/mano
# Python 3.10 interpreter used to build the environment. Default: python3
# export EGOTAC_BASE_PYTHON=/usr/bin/python3
# Force a CUDA build of PyTorch: cu118, cu124, or cu126. Default: chosen from nvidia-smi.
# export TORCH_CUDA=cu124
